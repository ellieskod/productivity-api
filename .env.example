# service variables.
# AGENT_KEYS: JSON map of agent name -> {"key_sha256": "<sha256 hex of agent key>", "scopes": ["calendar:read", "calendar:write"]}
AGENT_KEYS={}
# Calendar key = the path part of the Teamup link (teamup.com/<key>)
TEAMUP_CALENDAR_KEY=
TEAMUP_API_KEY=
# Optional: sub-calendar used for new events when the agent doesn't specify one
TEAMUP_DEFAULT_SUBCALENDAR_ID=
# Webhook secret shown in Teamup after creating the webhook (endpoint: https://<your-app>/webhooks/teamup)
TEAMUP_WEBHOOK_SECRET=

