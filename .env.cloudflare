# Cloudflare Worker Environment Variables

# Agent keys as JSON object with agent names and their SHA256 hashes and scopes
# Example: {"agent1": {"key_sha256": "...", "scopes": ["calendar:read", "calendar:write"]}}
AGENT_KEYS={}

# Teamup API Configuration
TEAMUP_CALENDAR_KEY=your_calendar_key_here
TEAMUP_API_KEY=your_api_key_here
TEAMUP_DEFAULT_SUBCALENDAR_ID=
TEAMUP_WEBHOOK_SECRET=your_webhook_secret_here
